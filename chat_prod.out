data: {"kind": "tool_call", "agent": "analyst", "name": "run_query", "args": {"query": "SELECT s.slugline, s.kind, s.summary, SUM(h.seeks) AS total_seeks FROM retention.seek_heatmap AS h JOIN retention.scenes AS s ON h.episode = s.episode AND h.to_bucket * 10 BETWEEN s.start_sec AND s.end_sec WHERE h.episode = 5 AND h.backward = 1 AND h.to_bucket > 0 GROUP BY s.slugline, s.kind, s.summary ORDER BY total_seeks DESC LIMIT 3"}}

data: {"kind": "tool_result", "agent": "analyst", "name": "run_query", "preview": "{\"columns\": [\"slugline\", \"kind\", \"summary\", \"total_seeks\"], \"rows\": [[\"INT. KELLEHER HOUSE - DAY\", \"dialogue\", \"The family, finally, in one room, saying what they know.\", 213], [\"INT. STATE FISHERIES OFFICE - DAY\", \"dialogue\", \"A state inspector listens, then asks who else knows.\", 189], [\"EXT. OCEAN - GIL'S BOAT - DAY\", \"action\", \"Sonar. Something on the bottom at fourteen feet: a sunken trap line, weighted with something that isn't traps.\", 155]]}"}

data: {"kind": "tool_call", "agent": "analyst", "name": "run_query", "args": {"query": "SELECT slugline, kind, summary, script_excerpt FROM retention.scenes WHERE episode = 5 AND scene_number IN (4, 5)"}}

