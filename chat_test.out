data: {"kind": "tool_call", "agent": "analyst", "name": "run_query", "args": {"query": "SELECT\n    scene_number,\n    slugline,\n    kind,\n    start_sec,\n    end_sec,\n    loss_per_minute\nFROM retention.scene_completion\nWHERE\n    episode = 4\n    AND kind != 'credits'\nORDER BY loss_per_minute DESC\nLIMIT 5\n"}}

data: {"kind": "tool_result", "agent": "analyst", "name": "run_query", "preview": "{\"columns\": [\"scene_number\", \"slugline\", \"kind\", \"start_sec\", \"end_sec\", \"loss_per_minute\"], \"rows\": [[13, \"INT. HARBORMASTER'S OFFICE - NIGHT\", \"exposition\", 2050, 2590, 0.024265769323710704], [3, \"INT. KELLEHER HOUSE - DAY\", \"dialogue\", 200, 390, 0.019243844168247513], [4, \"INT. BAIT SHOP - DAY\", \"dialogue\", 390, 600, 0.005377973034388729], [10, \"INT. KELLEHER HOUSE - KITCHEN - NIGHT\", \"dialogue\", 1570, 1770, 0.004750118990956687], [8, \"INT. BELL FISHERIES - OFFICE - DAY\", \"dialogue\", 1210, 1380, 0.004672897196261682]]}"}

data: {"kind": "tool_call", "agent": "analyst", "name": "run_query", "args": {"query": "WITH episode_retention AS (\n    SELECT\n        second,\n        retention\n    FROM retention.retention_curve\n    WHERE episode = 4\n)\nSELECT\n    second,\n    retention - lag(retention, 60) OVER (ORDER BY second) AS retention_drop\nFROM episode_retention\nWHERE second BETWEEN 2050 AND 2590\nORDER BY retention_drop\nLIMIT 1;\n"}}

data: {"kind": "tool_result", "agent": "analyst", "name": "run_query", "preview": "{\"columns\": [\"second\", \"retention_drop\"], \"rows\": [[2589, -0.02656862745098043]]}"}

data: {"kind": "tool_call", "agent": "analyst", "name": "run_query", "args": {"query": "SELECT\n    device,\n    region,\n    cdn,\n    sum(exits) AS total_exits\nFROM retention.exits_by_second\nWHERE\n    episode = 4\n    AND second BETWEEN 2529 AND 2589\nGROUP BY\n    device,\n    region,\n    cdn\nORDER BY total_exits DESC\nLIMIT 10\n"}}

data: {"kind": "tool_result", "agent": "analyst", "name": "run_query", "preview": "{\"columns\": [\"device\", \"region\", \"cdn\", \"total_exits\"], \"rows\": [[\"smart_tv\", \"NA\", \"edge-a\", 105], [\"smart_tv\", \"NA\", \"edge-b\", 85], [\"mobile\", \"NA\", \"edge-a\", 65], [\"smart_tv\", \"NA\", \"edge-c\", 58], [\"smart_tv\", \"EU\", \"edge-a\", 57], [\"mobile\", \"NA\", \"edge-b\", 51], [\"smart_tv\", \"EU\", \"edge-b\", 41], [\"mobile\", \"NA\", \"edge-c\", 35], [\"web\", \"NA\", \"edge-a\", 34], [\"mobile\", \"EU\", \"edge-b\", 32]]}"}

data: {"kind": "tool_call", "agent": "analyst", "name": "run_query", "args": {"query": "SELECT\n    minute,\n    device,\n    region,\n    cdn,\n    sum(rebuffers) AS total_rebuffers\nFROM retention.rebuffers_by_minute\nWHERE\n    episode = 4\n    AND minute IN (42, 43)\nGROUP BY\n    minute,\n    device,\n    region,\n    cdn\nORDER BY total_rebuffers DESC\nLIMIT 10\n"}}

