# Gemini
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
ANALYST_MODEL=gemini-2.5-pro
EDITOR_MODEL=gemini-2.5-pro

# ClickHouse (Cloud or self-hosted). Used by the mcp-clickhouse server (agent) and by the UI data endpoints.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=retention

# Path to the mcp-clickhouse executable (installed in its own venv because it needs mcp>=2 while ADK needs mcp<2)
MCP_CLICKHOUSE_BIN=/opt/mcp-clickhouse/bin/mcp-clickhouse

# Seeding
SESSIONS_PER_EPISODE=60000
